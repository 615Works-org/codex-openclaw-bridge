{
  "name": "codex-openclaw-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Thin Windows-native Discord bridge for a full local Codex instance and OpenClaw collaboration",
  "type": "module",
  "main": "dist/index.js",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/615Works-org/codex-openclaw-bridge.git"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "rollup": "^4.59.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
